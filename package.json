{
  "name": "tourwright",
  "version": "0.0.0",
  "private": true,
  "description": "Narrated walkthrough videos of your app's real React components: script in, MP4 out. Local voice, deterministic frames, no cloud.",
  "type": "module",
  "license": "MIT",
  "bin": {
    "tourwright": "./dist/cli/index.js",
    "walkthrough": "./dist/cli/index.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./stage": {
      "types": "./dist/runtime/stage.d.ts",
      "import": "./dist/runtime/stage.js"
    },
    "./schema/script.schema.json": "./schema/script.schema.json",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "schema",
    "skill"
  ],
  "workspaces": [
    "examples/*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "schema": "node src/schema/emit.ts",
    "test": "node --test \"test/**/*.test.ts\"",
    "prepack": "npm run build"
  },
  "dependencies": {
    "kokoro-js": "^1.2.1",
    "playwright": "^1.63.0",
    "vite": "^8.3.0",
    "zod": "^4.6.5"
  },
  "peerDependencies": {
    "react": ">=18",
    "react-dom": ">=18"
  },
  "devDependencies": {
    "@types/node": "^24.13.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.18"
  },
  "keywords": [
    "video",
    "walkthrough",
    "demo",
    "react",
    "playwright",
    "tts",
    "documentation"
  ]
}
